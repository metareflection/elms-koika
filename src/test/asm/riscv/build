#!/usr/bin/env zsh

# usage: ./build

here=${0:a:h}

# Duplicated from `GenericKoikaDriver`: SECRET is `4 * secret_offset` and SIZE
# is `RiscVDriver.password_size_bytes`. A real assembler cannot hear Scala, so
# the suite reads these back out of the object as ABS symbols and compares. Move
# one without the other and a test says so.
SECRET=80
SIZE=16

# clang's integrated assembler covers RISC-V, so the common case wants no cross
# toolchain at all. The gcc names are written from the documented flags and have
# never run: this box has x86_64 gcc only.
as=()
if echo 'addi x1, x0, 1' | clang --target=riscv32 -march=rv32im -mabi=ilp32 \
        -c -x assembler -o /dev/null - 2>/dev/null; then
    as=(clang --target=riscv32)
else
    for gcc in riscv64-linux-gnu-gcc riscv64-unknown-elf-gcc riscv64-elf-gcc \
               riscv32-unknown-elf-gcc riscv32-elf-gcc; do
        (( $+commands[$gcc] )) && as=($gcc) && break
    done
fi

if (( ! $#as )); then
    echo "no RISC-V assembler found; install clang or a riscv{64,32}-*-gcc" >&2
    exit 1
fi

# `rv32im` and not `rv32i`, so a demo may write `mul`. The extension only
# widens what the assembler accepts: every `.text` in the tree came out
# byte-identical when it was turned on, and what moved was `.riscv.attributes`,
# which nothing reads. `div` and `rem` the tower still refuses, and it refuses
# them at the reader rather than here.
assemble() {
    $as -march=rv32im -mabi=ilp32 -mno-relax \
        -Wa,--defsym,SECRET=$SECRET -Wa,--defsym,SIZE=$SIZE "${@:3}" \
        -c $1 -o $2 || exit 1
}

# `pht/` is the one family that arrives as C rather than as assembly, so the
# same driver compiles instead of assembling. Everything else in the tree keeps
# its `.s` checked in.
#
# `-enable-global-merge=false` is load bearing and clang-only. With merging on,
# the pass re-emits every global and `.secret` comes out ahead of `.attacker`,
# so reading past `publicarray` reaches `probe` instead of the key and six
# gadgets quietly stop being gadgets. gcc has no such pass and wants no flag.
merge=()
[[ ${as[1]} == clang ]] && merge=(-mllvm -enable-global-merge=false)

compile() {
    $as -march=rv32im -mabi=ilp32 -mno-relax -O1 $merge -c $1 -o $2 || exit 1
}

for src in $here/*.s; do
    # `probe.s` is a family and not a demo, so it is assembled below instead.
    [[ ${src:t} == probe.s ]] && continue
    echo "Assembling ${src:t}"
    assemble $src ${src:r}.o
done

# The probe-count dial. One source, one object per k, because the count is an
# assembler repeat and `demo` takes a name rather than a parameter.
PROBE_COUNTS=(1 2 3 4 5 6)
for k in $PROBE_COUNTS; do
    echo "Assembling probe.s at $k probe(s)"
    assemble $here/probe.s $here/probe$k.o -Wa,--defsym,PROBES=$k
done

for src in $here/pht/*.c; do
    echo "Compiling pht/${src:t}"
    compile $src ${src:r}.o
done
