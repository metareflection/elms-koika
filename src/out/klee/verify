#!/usr/bin/env zsh

# usage: ./verify [--slow | --only-slow] [--corpus] [--full] [files...]
#
# Checks every KLEE residue against the verdict its test declared. With no
# arguments that is the main suite: every snapshot under this directory except
# the ones --full adds back. Exits non-zero when any file disagrees, so this is
# a test and not a report.
#
# Naming files explicitly runs exactly those, main suite or not.
#
# A file whose line says `likely-timeout` is one the tree expects KLEE not to
# finish, and those are skipped unless you pass --slow, or --only-slow to run
# nothing else. Skipped files are printed, so a default run still says what it
# did not look at. Twelve files in the main suite are in that state. Ten finish
# and spend most of a budget doing it, and the other two produce no verdict at
# all, which is the whole reason for the flag. Nine more carry it outside the
# main suite: one under `lockstep/`, six under `probe/` where the whole subtree
# is held back anyway, and two under `stl/forwarding` in the corpus tier.
#
# The claim lives in the file, on the `// verify:` line that `KoikaSuite.check`
# writes at the top of it, same as `src/out/cbmc/verify` reads. What differs is
# the bound: CBMC gets a loop unwinding depth, KLEE gets wall-clock, because
# KLEE unrolls symbolically until every path terminates and so has no depth to
# cap.
#
# The residue is the same text here as it is under `src/out/cbmc`. Only the
# prelude differs, which is `Prover.intrinsics` and nothing else, so
#
#   diff src/out/{cbmc,klee}/riscv/cache/2ctr.check.c
#
# should show that block and no more.

# Reading a verdict out of KLEE takes three conditions, and the obvious two are
# not enough.
#
# KLEE exits 0 whether or not an assertion fired and writes `*.assert.err` into
# its output directory instead, so the error files are condition one. Condition
# two is that the run actually finished: `completed paths > 0` with
# `partially completed paths == 0`. Condition three is that KLEE did not stop
# early, which its stderr says and nothing else does.
#
# Two and three are what CBMC does not need. A short `--unwind` shows up under
# `src/out/cbmc/verify --certify` as a failed unwinding assertion, so CBMC's
# incompleteness is a bound that can be checked. KLEE's is an exploration that
# stops, and a stopped run exits 0 with no error files, which is byte-identical
# to a residue it genuinely verified. `riscv/cache/branchy` is the live example:
# 265,721 paths, none of them walked, and nothing in the exit status says so.
#
# Condition two only means anything once one is empty, because an error
# termination counts as a partial path too. `shortcircuit` reports twenty
# partial paths alongside one real error and is sound.
#
# A `likely-timeout` file passes on either its declared verdict or `unknown`.
# Demanding `unknown` would turn a faster solver into a failing test, and
# demanding the verdict is the thing KLEE cannot deliver here. Either way a
# finishing run still has to agree, so the claim never gets weaker than what
# CBMC already pinned next door.

here=${0:a:h}

# What the main suite leaves out, which is two groups, and the other two
# `verify` scripts leave out the same ones under the same two flags.
#
# `pht/` and `stl/` are the ported litmus corpora and `--corpus` adds them
# back. 109 files, most of them five to twenty-five instructions and answered
# in seconds, so for `pht/` the reason is coverage per second rather than cost:
# none of its 49 is a verdict the main suite cannot already state. `stl/` has a
# reason of its own on top of that, and it is this script's. Two of its cells,
# `stl/forwarding/stale_ptr` and `stale_index`, produce no verdict at all, and
# four more cost between 112 and 354 seconds apiece even now that
# `--exit-on-error` stops them at their witness.
corpus_only='(*/pht/*|*/stl/*)'

# The other three are `--full`'s, and a KLEE budget is the last thing to spend
# on any of them.
#
# `lockstep/` is five of the demos `squared/` answers, built by rewriting a
# residue rather than by interpreting the program over two states. It is kept
# for the day the two constructions disagree, and a budget is the last thing to
# spend finding out that they still agree.
#
# `dynamic/` is the same demos again with the control-flow assumption dropped,
# so a conditional comes out two ways and each run's tail is walked on its own
# rather than shared. That is an open question rather than a second opinion on
# a settled one, and for the sharper reason as well: dropping the assumption is
# dropping the pruning, so a split path is exactly where the search gets
# expensive.
#
# `probe/` is the third and the one this script has the strongest reason to
# skip. It is `riscv/cache/branchy` at one through six probes under both
# constructions, and KLEE's bill on that demo is the path space itself: 5s,
# 41s, 222s and 929s self-composed at one through four, with five and six never
# seen to finish. Twelve files, most of a budget apiece at the top of the dial,
# and no verdict the tree does not already have. It is here to be measured
# rather than to be run.
full_only='(*/lockstep/*|*/dynamic/*|*/probe/*)'

slow=0
only_slow=0
corpus=0
full=0
while [[ $1 == --* ]]; do
    case $1 in
        --slow)      slow=1 ;;
        --only-slow) slow=1; only_slow=1 ;;
        --corpus)    corpus=1 ;;
        --full)      full=1; corpus=1 ;;
        *) print -u2 -- "unknown flag $1"; exit 2 ;;
    esac
    shift
done

# KLEE reads bitcode, and bitcode only loads into a KLEE built against the same
# LLVM. So the clang that compiles a file has to be the one sitting beside the
# klee that reads it, which is why this does not reach for the host's.
#
# The pinned image is the default because it makes that pairing somebody else's
# problem. Set KOIKA_KLEE_NATIVE=1 to use a `klee` and `clang` already on PATH,
# which is on you to have built against matching versions.
image=${KOIKA_KLEE_IMAGE:-docker.io/klee/klee:3.1}
native=${KOIKA_KLEE_NATIVE:-0}

# Compile [1]/subject.c and check it with a [2] second budget, leaving
# `klee-out` beside it. Both arms write the same tree, so everything downstream
# reads one shape.
#
# Two things wrap the `klee` call and neither of them is `--max-time`'s job.
#
# `--exit-on-error` stops at the first assertion. Without it KLEE prints `now
# ignoring this error at this location` and carries on through a space that may
# never close, so on a file that does leak the verdict gets written to
# `klee-out` and nobody ever reads it. It cannot change an answer, because
# `outcome` globs `*.err` before it looks at anything else. It only arrives at
# the same answer sooner, measured across the nine files declaring `leak`: five
# of them now stop at their witness between 108 and 354 seconds.
#
# `timeout -k` is the wall clock, because `--max-time` is not one. In a single
# sweep it stopped two files at exactly their budget and let two others run
# past it until something else killed them, same box, minutes apart, and what
# separates those is not known. Plain `timeout` is not enough either, since
# KLEE catches SIGTERM to flush statistics and one blocked inside STP never
# gets to. The inner guard is the one that matters under podman: killing
# `podman run` from outside leaves the container alive and burning CPU, which
# is how a 900-second budget became 10582 seconds. So the two wrappers are not
# one wrapper written twice, and collapsing them to the outer one puts that
# back. It would read as a hang rather than as the tidy-up it was.
check_one() {
    local dir=$1 budget=$2
    local wall=$(( budget + 60 ))
    if (( native )); then
        clang -emit-llvm -c -g -O0 -Xclang -disable-O0-optnone -DKLEE \
              $dir/subject.c -o $dir/subject.bc >$dir/cc.log 2>&1 || return 1
        timeout -k 10 $wall \
            klee --max-time=${budget}s --exit-on-error --output-dir=$dir/klee-out \
                 $dir/subject.bc >$dir/klee.log 2>&1
    else
        timeout -k 10 $(( wall + 30 )) \
        podman run --rm --user root -v $dir:/work:rw,Z -w /work $image bash -c "
            export PATH=/home/klee/klee_build/bin:/tmp/llvm-130-install_O_D_A/bin:\$PATH
            clang -I /home/klee/klee_src/include -emit-llvm -c -g -O0 \
                  -Xclang -disable-O0-optnone -DKLEE \
                  subject.c -o subject.bc >cc.log 2>&1 || exit 1
            timeout -k 10 $wall \
                klee --max-time=${budget}s --exit-on-error --output-dir=/work/klee-out \
                     subject.bc >klee.log 2>&1
        " >/dev/null 2>&1
    fi
    # Not the exit status of either tool. clang's is the only one that means
    # anything, and a failed compile is the `return 1` above. A run the wall
    # clock killed leaves `info` with no completed-paths line, which `outcome`
    # reads as `unknown`, and `unknown` is what a `likely-timeout` file passes
    # on.
    [[ -f $dir/klee-out/info ]]
}

# clean, leak or unknown, by the three conditions above.
outcome() {
    local dir=$1
    local info=$dir/klee-out/info

    local errs=($dir/klee-out/*.err(N))
    if (( $#errs )); then
        print leak
        return
    fi

    local completed=$(sed -n 's/.*completed paths = \([0-9]*\)/\1/p' $info | head -1)
    local partial=$(sed -n 's/.*partially completed paths = \([0-9]*\)/\1/p' $info)
    : ${completed:=0} ${partial:=0}

    if grep -qi 'halting execution' $dir/klee.log || (( partial > 0 || completed == 0 )); then
        print unknown
    else
        print clean
    fi
}

typeset -i held_back=0

files=($@)
if (( ! $#files )); then
    files=(${here}/**/*.check.c(N))
    typeset -i corpus_held=0 deep_held=0
    if (( ! corpus )); then
        corpus_held=${#${(M)files:#${~corpus_only}}}
        files=(${files:#${~corpus_only}})
    fi
    if (( ! full )); then
        deep_held=${#${(M)files:#${~full_only}}}
        files=(${files:#${~full_only}})
    fi
    (( corpus_held )) && print -- "skip     $corpus_held under pht/ and stl/ (pass --corpus to check them)"
    (( deep_held )) && print -- "skip     $deep_held under lockstep/, dynamic/ and probe/ (pass --full to check them)"
    held_back=$(( corpus_held + deep_held ))
fi

if (( ! $#files )); then
    print -- "no snapshots under ${here#$PWD/} (generate them with \`sbt testFull\`)"
    exit 1
fi

typeset -i failures=0 skipped=0
work=$(mktemp -d)
trap "rm -rf $work" EXIT

for file in $files; do
    name=${file#$PWD/}
    expected=$(sed -n '1s|^// verify: \([a-z]*\).*|\1|p' $file)
    if [[ -z $expected ]]; then
        print -- "no-claim $name (regenerate it with \`sbt testFull\`)"
        (( failures++ ))
        continue
    fi

    # A demo the tree expects KLEE not to finish. Both outcomes pass: the
    # verdict if it somehow gets there, `unknown` if it runs out of budget.
    if sed -n '1p' $file | grep -q likely-timeout; then
        if (( ! slow )); then
            print -- "skip     $name (likely-timeout; pass --slow to run it)"
            (( skipped++ ))
            continue
        fi
        alternative=unknown
    else
        if (( only_slow )); then
            (( skipped++ ))
            continue
        fi
        alternative=$expected
    fi

    budget=$(sed -n '1s|.*\[budget \([0-9]*\)s\].*|\1|p' $file)
    : ${budget:=120}

    dir=$work/run
    rm -rf $dir && mkdir -p $dir
    cp $file $dir/subject.c

    if ! check_one $dir $budget; then
        print -- "ERROR    $name did not compile or KLEE did not start"
        cat $dir/cc.log $dir/klee.log 2>/dev/null
        (( failures++ ))
        continue
    fi

    actual=$(outcome $dir)

    if [[ $actual == $expected || $actual == $alternative ]]; then
        print -- "ok       $name ($actual, ${budget}s)"
    else
        print -- "MISMATCH $name: claims $expected, KLEE says $actual"
        cat $dir/klee.log
        (( failures++ ))
    fi
done

note=""
parts=()
(( skipped )) && parts+=("$skipped skipped")
(( held_back )) && parts+=("$held_back held back")
(( $#parts )) && note=" (${(j:, :)parts})"

if (( failures )); then
    print -- "$failures of $#files disagree$note"
    exit 1
fi

print -- "all $(( $#files - skipped )) agree$note"
