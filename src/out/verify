#!/usr/bin/env zsh

# usage: ./verify <files>...

# `--property main.assertion.1` is the timing leak and nothing else.
#
# Without it CBMC also checks every automatic property it generates for the
# residue, which on `fact/*/salsa20.check.c` is 6537 of them: 6048 pointer
# dereference checks, 445 overflow, 11 array bounds, 32 undefined shift, and
# then ours. Those are questions about the generated C rather than about the
# program it models, and they are the entire cost. Naive Salsa20 answers in five
# seconds this way and had not finished in seventy-two minutes without it.
#
# Verdicts do not move. The demos that passed still pass and the ones that
# detect a leak still fail; on a twenty-instruction demo the other 6536 checks
# were just cheap enough not to notice.

for file in $@; do
    echo "Verifying $file"
    cbmc -DCBMC --verbosity 4 --slice-formula --unwind 1000 --refine \
         --compact-trace --property main.assertion.1 $file
done
