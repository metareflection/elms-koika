#!/usr/bin/env zsh

# usage: ./verify [--full] [files...]
#
# Checks every Eva residue against the verdict its test declared. With no
# arguments that is the main suite: every snapshot under this directory except
# the ones --full adds back. Exits non-zero when any file disagrees, so this is
# a test and not a report.
#
# Naming files explicitly runs exactly those, main suite or not.
#
# The claim lives in the file, on the `// verify:` line that `KoikaSuite.check`
# writes at the top of it, same as the other two `verify` scripts read. What
# differs is the question being asked. CBMC and KLEE both read the self-composed
# program and decide whether the two timers can actually differ; Eva asks only
# whether the secret reaches the timer at all. So a demo whose two arms cost the
# same is a leak here and clean next door, and its line says `leak widened` so
# that the disagreement is a declaration rather than a surprise to whoever
# diffed the trees.
#
# The obligation itself is one line of ACSL in `main`,
#
#   //@ assert untainted_timer: !\tainted(s1_->timer==s2_->timer);
#
# which is a C comment and so rides in the residue every backend reads. CBMC and
# KLEE preprocess it away. One per file and not one per slot, even where the
# squared and lockstep towers compare the clocks on the way into every slot:
# those comparisons prune a search and name the slot a drift began in, which are
# both worth paying for to a checker that decides whether the timers can differ
# and worth nothing to one asking whether the secret arrives at all.
#
# The bound on the line is `[unroll N]`, off the same
# `GenericKoikaDriver.unwind` CBMC unwinds to, and spent on recursive calls
# rather than on loops. Frama-C parses C directly, so there is no bitcode and no
# LLVM pairing to arrange, which is why none of the podman arm
# `src/out/klee/verify` carries is needed here.

# Reading a verdict out of Eva takes two conditions, and the obvious one alone
# is unsound.
#
# Eva reports an unproven assertion on a line of its own, by the label the
# annotation gave it, and exits 0 doing it, so that line is condition one.
# Condition two is that `main` reached its last statement. Some demos stage a
# loop into a cycle of slots; Eva declines to unroll one past its bound, the
# imprecision widens an index to top, and the out-of-bounds access that follows
# is proved invalid and reduces the state to bottom. `main` never reaches the
# sink, Eva never complains about the assertion, and a reader that takes no
# complaint for a proof reports one it never had. An early sweep did exactly
# that and had to be thrown out.
#
# It catches less than it used to, and the measurement is worth having. Thirty-
# one of the 214 residues need `[unroll 65]` to answer what the tree claims. At
# the default bound eight come out non-terminating and the other twenty-three
# reach the sink in a state too imprecise to prove anything, reporting `leak` on
# a program the tree calls clean. Both fail, since neither matches the claim, so
# nothing gets past this either way. What the second kind costs is the
# diagnostic: `unknown` says the bound is short and `leak` says the secret
# reached the timer, and only one of those points at the fix.
#
# Which is the same shape `src/out/klee/verify` describes for a run that stopped
# early, where exit 0 with no error files is byte-identical to a residue KLEE
# genuinely verified.
#
# `-report -report-print-properties` prints a per-property table, and with the
# obligation written as a named assertion it is readable in a way the stub this
# replaced never was: a proof gets `[  Valid  ] Assertion 'untainted_timer'` and
# a leak gets the same row at `[    -    ]`. Worth passing when debugging one
# file. Still not what this script reads, because the table says nothing about
# whether the state the assertion was evaluated in was worth anything, which is
# the next paragraph.
#
# `unknown` is the third outcome and nothing in the tree produces one, which is
# exactly why the case is here. The day something does, it has to fail rather
# than pass.

here=${0:a:h}

# What the main suite leaves out, and the other two `verify` scripts leave out
# the same two trees.
#
# `lockstep/` is five of the demos `squared/` answers, built by rewriting a
# residue rather than by interpreting the program over two states, and it is
# kept for the day the two constructions disagree rather than for coverage it
# adds, which is none. `dynamic/` is those demos again with the control-flow
# assumption dropped, so a conditional comes out two ways, which is an open
# question rather than a second opinion on a settled one.
#
# Neither reason is about cost here, since Eva is cheap on both. They are held
# back so a default run of all three scripts covers the same files, and a
# three-way disagreement is then about the backends rather than about which tree
# somebody remembered to check.
full_only='(*/lockstep/*|*/dynamic/*)'

full=0
while [[ $1 == --* ]]; do
    case $1 in
        --full) full=1 ;;
        *) print -u2 -- "unknown flag $1"; exit 2 ;;
    esac
    shift
done

# Analyse [1]/subject.c with a recursion bound of [2], leaving `eva.log` beside
# it. True when frama-c got far enough to say anything.
#
# Not its exit status, which answers neither question this script asks: it is 0
# on a residue whose precondition went unproven and 1 on one whose state went to
# bottom. `-report-exit-code` would make it mean something and is deliberately
# not passed, because the log says more than a status can. The summary banner is
# what says frama-c ran, the way `klee-out/info` does next door.
analyse() {
    local dir=$1 unroll=$2
    frama-c -cpp-extra-args=-DEVA -eva -eva-domains taint \
            -eva-unroll-recursive-calls $unroll \
            -eva-no-results -report \
            $dir/subject.c >$dir/eva.log 2>&1
    grep -q 'ANALYSIS SUMMARY' $dir/eva.log
}

# clean, leak or unknown, out of the one row `-report` prints for the one
# assertion this backend cares about.
#
# An absent row is the whole positive check. Eva prints a row for a property it
# evaluated, so no row means it never got there, and that is the case a reader
# of the status alone would call clean and be wrong about.
outcome() {
    local log=$1
    local reported=$(
        sed -n "s/^\[\([^]]*\)\].*Assertion 'untainted_timer'.*/\1/p" $log |
            head -1 | tr -d ' '
    )
    case $reported in
        # Never reached, so nothing was decided either way.
        ''|Dead) print unknown ;;
        Valid)   print clean ;;
        # `-` is what an unproven one prints. Anything else is a status this
        # script has not seen, and guessing clean about it is the one mistake
        # that matters.
        *)       print leak ;;
    esac
}

typeset -i held_back=0

files=($@)
if (( ! $#files )); then
    files=(${here}/**/*.check.c(N))
    if (( ! full )); then
        held_back=${#${(M)files:#${~full_only}}}
        files=(${files:#${~full_only}})
        (( held_back )) && print -- "skip     $held_back under lockstep/ and dynamic/ (pass --full to check them)"
    fi
fi

if (( ! $#files )); then
    print -- "no snapshots under ${here#$PWD/} (generate them with \`sbt testFull\`)"
    exit 1
fi

typeset -i failures=0
work=$(mktemp -d)
trap "rm -rf $work" EXIT

for file in $files; do
    name=${file#$PWD/}
    expected=$(sed -n '1s|^// verify: \([a-z]*\).*|\1|p' $file)
    if [[ -z $expected ]]; then
        print -- "no-claim $name (regenerate it with \`sbt testFull\`)"
        (( failures++ ))
        continue
    fi

    # Every snapshot this tree has ever held carries the bracket. The fallback
    # is for a probe somebody drops in here by hand.
    unroll=$(sed -n '1s|.*\[unroll \([0-9]*\)\].*|\1|p' $file)
    : ${unroll:=1000}

    dir=$work/run
    rm -rf $dir && mkdir -p $dir
    cp $file $dir/subject.c

    if ! analyse $dir $unroll; then
        print -- "ERROR    $name did not parse or Eva did not start"
        cat $dir/eva.log
        (( failures++ ))
        continue
    fi

    actual=$(outcome $dir/eva.log)

    if [[ $actual == $expected ]]; then
        print -- "ok       $name ($actual)"
    else
        print -- "MISMATCH $name: claims $expected, Eva says $actual"
        cat $dir/eva.log
        (( failures++ ))
    fi
done

note=""
(( held_back )) && note=" ($held_back held back for --full)"

if (( failures )); then
    print -- "$failures of $#files disagree$note"
    exit 1
fi

print -- "all $#files agree$note"
